{
  "name": "github-issue-investigator",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-first GitHub investigations over MCP",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --import tsx src/server.ts",
    "demo": "npm run build && node dist/demo.js",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "smoke:live": "npm run build && node dist/live-smoke.js",
    "case:collect": "npm run build && node dist/collect-evidence.js",
    "dashboard:build": "node dashboard/scripts/build.mjs",
    "dashboard": "npm run dashboard:build && node dashboard/scripts/serve.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
